# Everything here is optional. With no variables the app runs from a local
# JSON file (.data/zaitoon-data.json) and generates its own keys.

# Postgres connection string (Neon, Supabase, Vercel Postgres, ...).
# Required on serverless hosting such as Vercel so data is shared and kept.
# DATABASE_URL=postgres://user:password@host:5432/database

# strict = verify the database certificate, off = no TLS.
# Default: TLS without certificate verification for hosted databases.
# DATABASE_SSL=strict

# Connections kept per server instance (default 3).
# DATABASE_POOL_MAX=3

# Initial staff PINs (4 to 6 digits). Set your own on a public address.
# ADMIN_PIN=2580
# KITCHEN_PIN=1111
# WAITER_PIN=2222

# off = the public pitch page stops showing scannable table codes.
# DEMO_MODE=off

# Secret used to sign staff sessions. Generated and stored when missing.
# SESSION_SECRET=

# Web Push keys. Generated and stored when missing.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=https://zaitoonfamilyrestaurant.com
